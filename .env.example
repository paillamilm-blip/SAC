# ─────────────────────────────────────────────────────────────
# Variables de entorno del frontend (Vite).
# Copia este archivo a ".env.local" y rellena con tus valores.
# NUNCA subas .env.local al repositorio (ya está en .gitignore).
#
# OJO: toda variable que empieza con VITE_ y que el código lea queda PUBLICADA dentro de la app:
# cualquiera la ve en el navegador. Nunca pongas una clave secreta en una variable VITE_.
# ─────────────────────────────────────────────────────────────

# URL de tu proyecto Supabase (Settings → API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública "anon" de Supabase (Settings → API). Es pública por diseño;
# la seguridad real la dan las políticas RLS de la base de datos.
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Qué analiza el CV. Por defecto, la IA de Ómicrom (Edge Function proxy-ai).
# Pon "demostracion" para usar la muestra fija (pruebas, recorrido visual en CI). No es un secreto.
# VITE_BRECHA_ANALISIS=demostracion

# ─────────────────────────────────────────────────────────────
# SECRETOS DEL SERVIDOR (no son del frontend). Se configuran en:
# Supabase → Project Settings → Edge Functions → Secrets.
# Se listan aquí solo como referencia. Detalle en docs/operacion.md.
# ─────────────────────────────────────────────────────────────
#   GEMINI_API_KEY          = clave de Google AI Studio (proxy-ai)
#   OPENROUTER_KEY          = clave de OpenRouter (respaldo de IA y voz)
#   CREDENTIAL_SIGNING_KEY  = clave para firmar credenciales (si la cambias, las ya emitidas dejan de verificar)
#   ALLOWED_ORIGINS         = orígenes permitidos por CORS (debe incluir https://sac-omi.vercel.app)
#   PUBLIC_SITE_URL         = https://sac-omi.vercel.app
